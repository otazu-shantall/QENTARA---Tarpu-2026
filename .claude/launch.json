{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tarpu-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "plataforma/frontend",
        "run",
        "dev"
      ],
      "port": 5174,
      "url": "http://127.0.0.1:5174"
    },
    {
      "name": "tarpu-api",
      "runtimeExecutable": "plataforma/backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "tarpu_api.main:app",
        "--app-dir",
        "plataforma/backend",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "tarpu-api-8001",
      "runtimeExecutable": "plataforma/backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "tarpu_api.main:app",
        "--app-dir",
        "plataforma/backend",
        "--port",
        "8001"
      ],
      "port": 8001,
      "url": "http://127.0.0.1:8001"
    }
  ]
}
