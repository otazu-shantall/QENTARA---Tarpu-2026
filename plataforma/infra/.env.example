# npm start crea infra/.env (git lo ignora) con la clave LOCAL de Supabase. A mano: `npm run db:status` en plataforma/.
# Nunca pongas aquí claves de producción ni las subas al repositorio.
TARPU_SUPABASE_SERVICE_KEY=
# Earthdata (solo para NASADEM y AppEEARS)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
TARPU_ACTUALIZAR_CADA_HORAS=6
# IA opcional: explica la evidencia de TARPU; claves solo en el servidor.
# Asistencia de IA (Codex); registro en entrega/uso-de-ia.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Selección opcional: claude | openai | gemini. Sin selección usa el primer proveedor configurado.
TARPU_IA_PROVEEDOR=
TARPU_CLAUDE_MODEL=claude-opus-5-5
TARPU_OPENAI_MODEL=gpt-6.1-sol
TARPU_GEMINI_MODEL=gemini-4-hydrogen
# No habilitar TARPU_CHATGPT_LOCAL en Cloud Run ni en un servidor compartido.
