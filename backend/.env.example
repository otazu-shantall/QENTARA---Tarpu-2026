# Copia este archivo como backend/.env si quieres cambiar algo. Ningún valor es secreto.
# Rutas relativas a la carpeta backend/.

# en_vivo (API) o publicado (JSON exportado). Los datos son reales en los dos casos.
TARPU_MODO=en_vivo
TARPU_DATOS_DIR=../datos
TARPU_ALMACEN_DIR=almacen
TARPU_CATALOGO=catalogo/ecocrop_2026-11-14.json
TARPU_EXPORT_DIR=../Codigo/public/api
TARPU_CORS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Período de la serie diaria de NASA POWER que se pide para cada parcela (AAAA-MM-DD).
# Es el mismo del ejemplo contrato/ejemplos/indicadores_chivay.json.
TARPU_POWER_INICIO=2015-01-01
TARPU_POWER_FIN=2025-12-31

# Credenciales que usan SOLO los conectores del área de datos (AppEEARS). Nunca en el repositorio.
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# Actualización periódica de los datos (tarpu_datos.actualizar, DT-22). Vacío = apagada.
# TARPU_ACTUALIZAR_CADA_HORAS=6
# Períodos en días por tarea (JSON), si se quieren cambiar:
# TARPU_PERIODOS={"base_power": 7, "puntos_power": 7, "puntos_modis": 8, "puntos_cobertura": 30}
