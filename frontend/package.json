{
  "name": "tarpu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototipo de escritorio de TARPU",
  "ai_assistance": "Código desarrollado con asistencia de IA; registro en entrega/uso-de-ia.md.",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "node tests/browser.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.{ts,mjs}\" vite.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.554.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "^7.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "1.9.20",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
